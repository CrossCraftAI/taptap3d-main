# Copy to .env and fill in. Never commit .env.

# Postgres. Local development runs against Docker; production is a managed
# instance co-located with the app.
DATABASE_URL=postgres://taptap3d:taptap3d@localhost:5432/taptap3d

# THE M0 ACCESS GATE — not authentication, and not a substitute for it.
#
# A single shared secret in front of the whole deployed application, so a public
# URL is not a public database while the real identity system is deferred
# (ROADMAP D14). The predecessor shipped to the public internet with no gate at
# all and an unauthenticated DELETE endpoint; that is what this prevents.
#
# Leave GATE_PASSWORD empty in local development to disable the gate.
GATE_USER=taptap3d
GATE_PASSWORD=
