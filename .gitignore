# dependencies
node_modules/
.pnp
.pnp.js

# next
.next/
out/
next-env.d.ts

# production
build/
dist/

# environment
.env
.env.local
.env*.local

# working data — assets, renders, probe output
.data/

# client material. Never committed: these are other people's copyrighted
# catalogues and other people's lot data.
samples/

# os / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# logs
*.log
npm-debug.log*

# test / coverage
coverage/
.vitest/
# Playwright. The screenshots are a deliverable of a RUN, not of the repository —
# they are regenerated by `npx playwright test` and committing them would grow
# the history by a megabyte every time someone moved a border.
test-results/
playwright-report/
# The trailing wildcard covers the per-project directories test/e2e/shots.ts
# makes — screens-webkit and whatever engine comes after it.
test/e2e/screens*/
# The UI inspection loop's output, for the same reason: scripts/inspect.mjs and
# scripts/inspect-driven.mjs regenerate every frame of it, and a hundred PNGs a
# run is exactly the megabyte the rule above refuses. The SCRIPTS are committed;
# their pictures are not.
ui-inspect/
ui-inspect-driven/

# typescript
*.tsbuildinfo

# Claude Code's own directory. `settings.local.json` is one developer's
# permission choices, and `worktrees/` holds real git worktrees — committing
# those adds them as embedded repositories, which clone as empty directories
# and confuse everyone who checks out afterwards.
.claude/
